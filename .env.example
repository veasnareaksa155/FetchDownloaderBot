# ==========================================
# Pro Video & Audio Downloader Telegram Bot
# ==========================================

# Obtain your bot token from Telegram's @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Optional: Comma-separated admin Telegram user IDs (e.g., 123456789,987654321)
ADMIN_USER_IDS=

# Max video size to download & upload to Telegram in MB (Telegram default bot limit is 50MB)
MAX_FILE_SIZE_MB=50

# Concurrency limit (maximum simultaneous downloads)
CONCURRENT_DOWNLOADS=5

# Network timeouts (in seconds)
API_TIMEOUT=25
DOWNLOAD_TIMEOUT=120

